{
    "$schema": "https://opencode.ai/config.json",
    "enabled_providers": ["ollama"],
    "model": "ollama/ornith-1.5:9b",
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "{env:PRIVATE_SERVER_BASE}:11434/v1"
            },
            "models": {
                "qwen3.5:4b": {
                    "tools": true,
                    "maxTokens": 4096
                },
                "qwen3.5": {
                    "tools": true,
                    "maxTokens": 4096
                },
                "qwen3.5:latest": {
                    "tools": true,
                    "maxTokens": 4096
                },
                "gemma4:e2b": {
                    "tools": true,
                    "maxTokens": 4096
                },
                "gemma4:e4b": {
                    "tools": true,
                    "maxTokens": 4096
                },
                "ornith-1.5:9b": {
                    "tools": true,
                    "maxTokens": 4096
                }
            }
        }
    },
    "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "question": "allow",
        "bash": {
            "*": "ask",
            "ls *": "allow",
            "echo *": "allow",
            "cat *": "allow",
            "wc *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "sort *": "allow",
            "uniq *": "allow",
            "grep *": "allow",
            "rg *": "allow",
            "find *": "allow",
            "fd *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "npm run *": "ask",
            "python *": "ask",
            "uv *": "ask",
            "deno lint *": "allow"
        },
        "external_directory": "ask",
        "doom_loop": "ask"
    }
}
